<style>
          .container {
           max-width: 1140px;
           margin-left: auto;
           margin-right: auto;
           padding-left: 16px;
           padding-right: 16px;
         }
         h1,h2, p {
         margin: 0;
         }
          .blog-padding{
          padding-top:70px;
          padding-bottom:70px;
         }
          .blog-heading{
          font-weight:600;
          font-size:48px;
          line-height:100%;
          color:black;
         }
         .blog-button {
         background-color: #01C6B5;
         color: #FFFFFF;
         padding: 16px 26px;
         border: none;
         font-weight: 500;
         font-size:20px;
         line-height:100%;
         cursor: pointer;
         transition: background-color 0.3s ease;
        }

        .blog-button:hover {
        background-color: #019e96;
        }
        .d-flex {
        display: flex;
        }
        .heading-parent{
           display: flex !important;
            justify-content: space-between;
               align-items:center;
        }
        .gap-24{
        gap:24px;
      }
      .cards-date{
      font-weight: 400;
         font-size:16px;
         line-height:100%;
         color:#414143;
         padding-bottom:13px;
      }
      .cards-heading{
          font-weight: 600;
         font-size:24px;
         line-height:100%;
         padding-bottom:5px;
      }
      .cards-description{
        font-weight: 400;
         font-size:16px;
         line-height:160%;
         color:#414143;
      }
    .card-parent-pt{
       padding-top:50px;
    }
  @media (max-width: 992px) {
    .blog-padding {
      padding-top: 80px;
      padding-bottom: 80px;
    }

    .d-flex {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
    }

    .blog-heading {
      font-size: 36px;
      text-align: center;
    }

    .cards-heading,
    .cards-description,
    .cards-date {
      text-align: center;
    }

    .d-flex.justify-content-between.align-items-center {
      flex-direction: column;
      gap: 20px;
    }

    .d-flex > div {
      width: calc(50% - 12px);
    }
  }

  @media (max-width: 767.98px) {
    .d-flex > div {
      width: 100%;
      max-width: 400px;
      margin-left: auto;
      margin-right: auto;
    }

    .gap-24 {
      gap: 32px;
      flex-direction: column;
    }

    .blog-button {
      font-size: 18px;
      padding: 14px 22px;
    }
  }
    @media (max-width: 576px) {
   .heading-parent{
         flex-direction:column !important;
         gap:15px;
        }
          .blog-padding {
      padding-top: 60px;
      padding-bottom: 60px;
    }
    .card-parent-pt{
       padding-top:30px;
    }
  }
</style>

<section class="blog-padding">
  <div class="container">
    <div class="heading-parent">
      <h1 class="blog-heading">{{ section.settings.heading }}</h1>
      {% if section.settings.button_text != blank %}
        <button class="blog-button">{{ section.settings.button_text }}</button>
      {% endif %}
    </div>
    <div class="d-flex gap-24 card-parent-pt">
      {% for card in section.blocks %}
        <div>
          {% if card.settings.image != blank %}
            <img
              src="{{ card.settings.image | image_url: width: 600 }}"
              alt="{{ card.settings.title | escape }}"
              width="364"
              height="321"
              style="width: 100%; height: auto; margin-bottom: 16px;"
            >
          {% endif %}

          <h2 class="cards-date">{{ card.settings.date }}</h2>
          <h2 class="cards-heading">{{ card.settings.title }}</h2>
          <p class="cards-description">{{ card.settings.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<script></script>

{% schema %}
{
  "name": "Dummy Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From The Blog"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "View All Blogs"
    }
  ],
  "blocks": [
    {
      "type": "blog_card",
      "name": "Blog Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "May 25, 2025"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Our Origins in Movement"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Rooted in France, Yogaova™ emerged from a desire to bring more style, sustainability...."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dummy section",
      "blocks": [{ "type": "blog_card" }, { "type": "blog_card" }, { "type": "blog_card" }]
    }
  ]
}
{% endschema %}
