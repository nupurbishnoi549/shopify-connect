{% schema %}
{
  "name": "About Wellenwerk",
  "tag": "section",
  "class": "about-wellenwerk",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "About GalaCube"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Plan Your Event"
    },
    {
      "type": "richtext",
      "id": "who_we_are",
      "label": "Who We Are",
      "default": "<p>Plan smart. Book fast. Or just get inspired.</p>"
    },
    {
      "type": "richtext",
      "id": "what_we_do",
      "label": "What We Do",
      "default": "<p>We've built GalaCube to simplify event planning and make it actually fun. Transparent, fast, and flexible – with trusted partners in locations, catering, photography, entertainment, and more. It’s all about great connections, smooth organization, and events that leave a mark. We hope you’ll love it.</p>"
    },
    {
      "type": "richtext",
      "id": "what_we_do_extra",
      "label": "What We Do (Extra Paragraph)",
      "default": "<p>We've built GalaCube to simplify event planning and make it actually fun. Transparent, fast, and flexible - with trusted partners in locations, catering, photography, entertainment, and more. It's all about great connections, smooth organization, and events that leave a mark. We hope you'll love it.</p>"
    },

    {
      "type": "url",
      "id": "brochure_link",
      "label": "Brochure Link"
    },
    {
      "type": "image_picker",
      "id": "img1",
      "label": "Left Top Image"
    },
    {
      "type": "image_picker",
      "id": "img2",
      "label": "Left Middle Image (Wide)"
    },
    {
      "type": "image_picker",
      "id": "img3",
      "label": "Left Bottom Image"
    },
    {
      "type": "image_picker",
      "id": "img4",
      "label": "Right Tall Image"
    },
    {
      "type": "image_picker",
      "id": "img5",
      "label": "Right Short Image"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 10,
      "max": 100,
      "default": 10,
      "step": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 10,
      "max": 100,
      "default": 10,
      "step": 10
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile Padding Top",
      "min": 10,
      "max": 100,
      "default": 10,
      "step": 10
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile Padding bottom",
      "min": 10,
      "max": 100,
      "default": 10,
      "step": 10
    }
  ],
  "presets": [
    {
      "name": "About Wellenwerk"
    }
  ]
}
{% endschema %}

<div class="about-wellenwerk-wrapper !bg-[{{ section.settings.background_color }}] !pt-[{{ section.settings.padding_top }}px] !pb-[{{ section.settings.padding_bottom }}px] max-md:pt-[{{ section.settings.mobile_padding_top }}px] max-md:pt-[{{ section.settings.mobile_padding_bottom }}px]">
  <div class="container">
    <div class="about-wellenwerk-content">
      <!-- Text Left -->
      <div class="about-wellenwerk-text">
        <h2 class="bricolage-grotesque-ff !normal-case !text-2xl !font-semibold !text-[#FCFCFC]">
          {{ section.settings.heading }}
        </h2>
        <div class="text-block !text-[#FCFCFC] !font-medium mb-[16px]">
          {{ section.settings.who_we_are }}
        </div>
        <div class="text-block flex flex-col">
          <div>
            <div class="!text-[#FCFCFC] !text-base !m-0">
              <div class="!my-0">{{ section.settings.what_we_do }}</div>
              <div class="!my-0">{{ section.settings.what_we_do_extra }}</div>
            </div>
          </div>

          <h4 class="bricolage-grotesque-ff !text-[#FCFCFC] !text-base !mb-0 !font-semibold">Let’s get started.</h4>

          {% if section.settings.button_text != blank %}
            <button class="!bg-[#BEDE41] !text-[#FCFCFC] !max-w-max font-semibold py-4 px-6 rounded !leading-[100%] text-center w-[200px]">
              {{ section.settings.button_text }}
            </button>
          {% endif %}
        </div>

        {% if section.settings.brochure_link != blank %}
          <a
            href="{{ section.settings.brochure_link }}"
            class="btn poppins-font btn-primary !text-[14px] !mt-[28px] max-md:!mt-[24px] transition-all duration-300 hover:!bg-white hover:!border-orange !border border-transparent hover:!text-orange max-md:!rounded-[4px]"
            target="_blank"
            >Eventmappe runterladen</a
          >
        {% endif %}
      </div>

      <!-- Image Grid Right -->
      <div class="about-wellenwerk-images">
        <div class="left-images !pt-[18px]">
          <div class="left-top">
            {% if section.settings.img1 %}
              <img
                loading="lazy"
                width="auto"
                height="auto"
                src="{{ section.settings.img1 | image_url: width: 400 }}"
                alt="Top Left"
              >
            {% endif %}
          </div>
          <div class="left-middle">
            {% if section.settings.img2 %}
              <img
                loading="lazy"
                width="auto"
                height="auto"
                src="{{ section.settings.img2 | image_url: width: 600 }}"
                alt="Middle Wide"
              >
            {% endif %}
          </div>
          <div class="left-bottom">
            {% if section.settings.img3 %}
              <img
                loading="lazy"
                width="auto"
                height="auto"
                src="{{ section.settings.img3 | image_url: width: 400 }}"
                alt="Bottom Left"
              >
            {% endif %}
          </div>
        </div>

        <div class="right-images">
          {% if section.settings.img4 %}
            <img
              loading="lazy"
              width="auto"
              height="auto"
              class="tall"
              src="{{ section.settings.img4 | image_url: width: 400 }}"
              alt="Right Tall"
            >
          {% endif %}
          {% if section.settings.img5 %}
            <img
              loading="lazy"
              width="auto"
              height="auto"
              src="{{ section.settings.img5 | image_url: width: 400 }}"
              alt="Right Short"
            >
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .about-wellenwerk-wrapper {
    background: #fff;
  }

  .about-wellenwerk-wrapper .container {
    max-width: 1140px;
    margin: auto;
    padding: 0 20px;
  }

  .about-wellenwerk-content {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    align-items: flex-start;
    flex-direction: row;
  }

  .about-wellenwerk-text {
    flex: 1 1 45%;
  }

  .about-wellenwerk-text h2 {
    font-size: 48px;
    font-weight: 700;
    margin-bottom: 24px;
  }


  .text-block h4 {
    font-size: 20px;
    font-weight: 500;
    margin-bottom: 16px;
  }
  .text-block p {
  font-family: "Roboto", sans-serif;
    color : #FCFCFC ;
    line-height : 150% ;
  }

  .btn-primary {
    display: inline-block;
    padding: 12px 20px;
    background-color: var(--color-orange);
    color: #fff;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
  }

  .about-wellenwerk-images {
    display: flex;
    flex: 1 1 50%;
    gap: 20px;
  }

  .left-images {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-end;
    justify-content: center;
  }

  .left-images .left-top img,
  .left-images .left-bottom img {
    width: 200px;
    border-radius: 8px;
    object-fit: cover;
  }

  .left-images .left-top img {
    height: 143px;
  }

  .left-images .left-bottom img {
    height: 158px;
  }

  .left-images .left-middle img {
    width: 307px;
    height: 217px;
    border-radius: 8px;
    object-fit: cover;
  }

  .right-images {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 226px;
    flex-shrink: 0;
  }

  .about-wellenwerk-images img {
    object-fit: cover;
    border-radius: 8px;
  }

  .right-images img.tall {
    height: auto;
    aspect-ratio: 2/3;
  }

  @media screen and (max-width: 768px) {
    .about-wellenwerk-content {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .about-wellenwerk-text {
      flex: 1 1 100%;
      order: 1;
    }

    .about-wellenwerk-images {
      flex: 1 1 100%;
      display: flex;
      justify-content: center;
      gap: 9px;
      order: 2;
    }

    .left-images, .right-images {
      gap: 9px;
    }

     .text-block p {
       font-size : 14px ;
  }

    .left-images .left-top img {
      width: 120px;
      height: 90px;
    }

    .left-images .left-middle img {
      width: 180px;
      height: 120px;
    }

    .left-images .left-bottom img {
      width: 120px;
      height: 100px;
    }

    .right-images {
      width: 160px;
    }

    .right-images img {
      width: 100%;
    }

    .right-images img.tall {
      aspect-ratio: 2/3;
    }
  }
</style>
