<section class="xl:py-[130px] lg:py-[100px] py-[90px] px-6">
  <div class="max-w-[790px] mx-auto">
    {% if section.settings.heading != blank %}
      <h2 class="lg:!text-custom-4xl md:!text-custom-3xl !text-custom-2xl font-semibold !font-secondary !leading-[120%] mb-4 text-center">
        {{ section.settings.heading }}
      </h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="md:text-base text-sm !font-primary font-normal leading-[120%] max-w-[585px] mx-auto !leading-[150%] opacity-[70%] !text-theme-black mb-10 text-center">
        {{ section.settings.subheading }}
      </p>
    {% endif %}

    <div id="faq-container" class="space-y-4">
      {% for block in section.blocks %}
        <div
          id="faq-item-{{ forloop.index0 }}"
          class="bg-white border border-[#01010114] overflow-hidden transition-all duration-300"
        >
          <button
            type="button"
            class="w-full flex justify-between items-center md:p-5 p-4 text-left faq-toggle"
            data-faq="{{ forloop.index0 }}"
            aria-expanded="false"
          >
            <span class="md:text-xl text-base font-semibold !text-theme-black !font-secondary text-left">
              {{- block.settings.question -}}
            </span>
            <svg
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              class="transition-transform duration-300 origin-center"
            >
              <path
                d="M3.07401 6.31706C2.99445 6.24188 2.90086 6.1831 2.79859 6.14409C2.69631 6.10508 2.58736 6.08659 2.47794 6.08968C2.36852 6.09278 2.26078 6.1174 2.16088 6.16213C2.06097 6.20686 1.97086 6.27083 1.89568 6.35039C1.82049 6.42995 1.76172 6.52354 1.72271 6.62581C1.68369 6.72809 1.66521 6.83704 1.6683 6.94646C1.6714 7.05588 1.69601 7.16362 1.74075 7.26352C1.78548 7.36343 1.84945 7.45354 1.92901 7.52873L9.42901 14.6121C9.58373 14.7583 9.78858 14.8398 10.0015 14.8398C10.2144 14.8398 10.4193 14.7583 10.574 14.6121L18.0748 7.52873C18.1561 7.45404 18.2218 7.36394 18.268 7.26367C18.3142 7.1634 18.34 7.05495 18.3439 6.94462C18.3478 6.83429 18.3298 6.72428 18.2908 6.62099C18.2519 6.51769 18.1928 6.42316 18.117 6.34289C18.0412 6.26263 17.9502 6.19822 17.8493 6.15342C17.7484 6.10861 17.6396 6.0843 17.5292 6.0819C17.4189 6.07949 17.3091 6.09904 17.2064 6.13941C17.1036 6.17978 17.0099 6.24017 16.9307 6.31706L10.0015 12.8604L3.07401 6.31706Z"
                fill="#010101"
              />
            </svg>
          </button>
          <div
            id="faq-content-{{ forloop.index0 }}"
            class="max-h-0 overflow-hidden transition-all duration-500 ease-in-out md:px-5 pl-4 pr-[34px] !text-theme-black"
            style="will-change:max-height;"
          >
            <p class="pb-5 !text-theme-black md:text-base text-sm font-normal opacity-[70%] !font-primary md:max-w-[640px] max-w-[277px]">
              {{ block.settings.answer }}
            </p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const toggles = document.querySelectorAll('.faq-toggle');

    toggles.forEach((button) => {
      button.addEventListener('click', function () {
        const index = this.dataset.faq;
        const content = document.getElementById('faq-content-' + index);
        const icon = this.querySelector('svg');
        const parent = document.getElementById('faq-item-' + index);

        // Close all other items
        document.querySelectorAll('[id^="faq-content-"]').forEach((el) => {
          if (el !== content) {
            el.style.maxHeight = '0px';
            el.previousElementSibling.classList.remove('spacing-active');
            el.previousElementSibling.querySelector('svg').style.transform = 'rotate(0deg)';
            el.parentElement.style.boxShadow = 'none'; // remove shadow
            el.parentElement.style.border = '1px solid #01010114'; // keep border
          }
        });

        // Toggle current FAQ
        if (content.style.maxHeight && content.style.maxHeight !== '0px') {
          // Closing
          content.style.maxHeight = '0px';
          this.classList.remove('spacing-active');
          icon.style.transform = 'rotate(0deg)';
          parent.style.boxShadow = 'none';
          parent.style.border = '1px solid #01010114'; // keep border
        } else {
          // Opening
          content.style.maxHeight = content.scrollHeight + 'px';
          this.classList.add('spacing-active');
          icon.style.transform = 'rotate(180deg)';
          parent.style.boxShadow = '0px 4px 24px 0px #00000014'; // shadow on open
          parent.style.border = '1px solid #01010114'; // border stays even when open
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "FAQ Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Have questions about our fabrics, shipping, or returns? You'll find answers to the most common queries below."
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "textarea", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "FAQ Section",
      "category": "Custom",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "We process and dispatch all orders within 24 to 48 hours after you place them. Once shipped, delivery usually takes between 3 to 7 business days, depending on your location and the courier service in your area."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Do you offer free shipping?",
            "answer": "We currently do not offer free shipping. Shipping charges will be calculated at checkout based on your location and the total order weight."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can I buy fabric in custom lengths?",
            "answer": "Yes, you can buy fabric in custom lengths. Please select the required length on the product page or contact us if you have specific requirements."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What types of fabrics do you offer?",
            "answer": "We offer a variety of fabrics including cotton, linen, silk, blends, and more. Please browse our collections to see the full range of fabrics available."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Are your fabrics pre-washed or pre-shrunk?",
            "answer": "Unless specifically mentioned in the product description, most of our fabrics are not pre-washed or pre-shrunk. We recommend pre-washing your fabric before use to prevent any shrinkage."
          }
        }
      ]
    }
  ]
}
{% endschema %}
