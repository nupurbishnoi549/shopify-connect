<section>
  <div class="!bg-black !min-h-[300px] !flex !gap-4 !items-start !justify-center !flex-wrap !p-6">
    {% if section.settings.collection %}
      {% assign collection = collections[section.settings.collection] %}
      <div class="!flex !gap-6 !flex-wrap !justify-center">
        {% for product in collection.products limit: 4 %}
          <div class="!bg-white !p-4 !rounded !text-black !w-[200px] !shadow">
            <h3 class="!text-lg !font-semibold">{{ product.title }}</h3>
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 200 }}"
                alt="{{ product.title }}"
                class="!w-[150px] !h-[150px] !object-cover !mx-auto"
                width="150"
                height="150"
              >
            {% endif %}
            <p class="!mt-2">{{ product.price | money }}</p>
            <a href="{{ product.url }}" class="!bg-green-500 !text-white !px-3 !py-1 !inline-block !rounded !mt-2"
              >View</a
            >
          </div>
        {% endfor %}
      </div>
    {% else %}
      <p class="!text-white">Please select a Collection.</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Try Section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    }
  ],
  "presets": [
    {
      "name": "Try Section"
    }
  ]
}
{% endschema %}
