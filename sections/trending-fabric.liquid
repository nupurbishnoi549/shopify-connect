  {% comment %} <section class="bg-[#FFFFFF] py-[60px] md:py-20 lg:py-[100px] px-6">
    <div class="mx-auto max-w-[1140px]">
      {% if section.settings.heading != blank %}
        <h2 class="text-center lg:!text-custom-4xl md:!text-custom-3xl !text-custom-2xl !font-primary font-bold !leading-[120%] !text-theme-black mb-6">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="max-w-[630px] mx-auto text-center !text-sm md:!text-base !font-primary leading-[150%] !text-theme-black opacity-70 mb-10">
          {{ section.settings.subheading }}
        </p>
      {% endif %}

      <!-- FLEX CONTAINER -->
      <div class="flex flex-wrap justify-center !gap-6">
        {% for block in section.blocks %}
          {% if block.type == 'product' and block.settings.product != blank %}
            {% assign product = all_products[block.settings.product] %}
            {% if product %}
              <!-- CARD -->
              <div class="flex flex-col !gap-0 w-full lg:w-[calc(33.333%-16px)] xl:max-w-[364px] sm:max-w-[305px]">
                <!-- IMAGE WRAPPER -->
                <div class="relative w-full h-[280px] lg:h-[310px]">
                  <img
                    src="{{ product.featured_image | img_url: 'master' }}"
                    alt="{{ product.title }}"
                    class="w-full h-full object-cover rounded"
                  >

                  <!-- Wishlist Button -->
                  <button class="absolute top-3 left-3 bg-white !p-[10px] rounded-full shadow">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                      <g opacity="0.5">
                        <path d="M6.2513 3.3335C3.72005 3.3335 1.66797 5.38558 1.66797 7.91683C1.66797 12.5002 7.08464 16.6668 10.0013 17.636C12.918 16.6668 18.3346 12.5002 18.3346 7.91683C18.3346 5.38558 16.2826 3.3335 13.7513 3.3335C12.2013 3.3335 10.8305 4.10308 10.0013 5.281C9.57859 4.67907 9.01711 4.18783 8.36437 3.84884C7.71162 3.50985 6.98682 3.33308 6.2513 3.3335Z" stroke="#010101" stroke-width="1.5" />
                      </g>
                    </svg>
                  </button>

                  <!-- Add to Cart -->
                  <form action="/cart/add" method="post" class="absolute bottom-3 right-3">
                    <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                    <button type="submit" class="flex items-center gap-1 bg-white px-3 py-1 rounded shadow text-sm">
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <g opacity="0.7">
                          <path d="M2.08398 3.5415C2.08398 3.37574 2.14983 3.21677 2.26704 3.09956C2.38425 2.98235 2.54322 2.9165 2.70898 2.9165H3.17398C3.96565 2.9165 4.44065 3.449 4.71148 3.944L5.12565 5.00317L15.624 4.99984C16.3156 4.99984 16.8157 5.6615 16.6257 6.32734L15.1023 11.6682C14.9657 12.1472 14.6768 12.5687 14.2792 12.8688C13.8817 13.169 13.3971 13.3314 12.899 13.3315H7.94232C7.44023 13.3315 6.95203 13.1667 6.55275 12.8622C6.15348 12.5578 5.86523 12.1307 5.73232 11.6465L5.09898 9.3365L4.04815 5.78984C3.91815 5.31734 3.79648 4.87484 3.61482 4.54484C3.44065 4.224 3.30065 4.1665 3.17482 4.1665H2.70898C2.54322 4.1665 2.38425 4.10066 2.26704 3.98345C2.14983 3.86624 2.08398 3.70726 2.08398 3.5415Z" fill="#010101"/>
                        </g>
                      </svg>
                      {% if product.available %}
                        Add
                      {% else %}
                        Sold Out
                      {% endif %}
                    </button>
                  </form>
                </div>

                <!-- DESCRIPTION -->
                <p class="md:!text-base font-semibold !leading-[150%] !font-primary text-sm !text-theme-black opacity-[70%] pt-5">
                  {{ product.description | strip_html | truncate: 60 }}
                </p>

                <!-- TITLE + PRICE -->
                <div class="mt-4 flex items-center justify-between w-full">
                  <span class="!text-[#01010166] border !border-[#222D5266] hover:bg-[#001F3F] hover:!text-white px-3 py-1 md:!text-base font-semibold !leading-[150%] !font-primary text-sm transition-colors duration-300">
                    {{- product.title -}}
                  </span>
                  <span class="font-bold !text-2xl !font-primary !leading-[150%] !text-theme-black">
                    {{ product.price | money_without_trailing_zeros }}
                  </span>
                </div>
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  {% schema %}
  {
    "name": "Trending Fabrics",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Trending Fabrics"
      },
      {
        "type": "textarea",
        "id": "subheading",
        "label": "Subheading",
        "default": "Discover what creators are loving — from best-selling prints to fast-moving seasonal styles, these fabrics are going fast for all the right reasons."
      }
    ],
    "blocks": [
      {
        "type": "product",
        "name": "Product",
        "settings": [
          {
            "type": "product",
            "id": "product",
            "label": "Select product"
          }
        ]
      }
    ],
    "max_blocks": 6,
    "presets": [
      {
        "name": "Trending Fabrics",
        "category": "Products",
        "blocks": [{ "type": "product" }, { "type": "product" }, { "type": "product" }]
      }
    ]
  }
  {% endschema %} {% endcomment %}
